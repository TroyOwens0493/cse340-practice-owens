<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/faculty.css">
<main>
    <h1>Faculty List</h1>
    <p>Here you can see a list of all our faculty members.</p>

<div class="faculty-list">
        <div class="sections-header">
            <h2>Faculty</h2>
            <div class="sort-options">
                <span>Sort by: </span>
                <a href="/faculty/?sort=name" class="<%= currentSort === 'name' ? 'active' : '' %>">Name</a>
                <a href="/faculty/?sort=department" class="<%= currentSort === 'department' ? 'active' : '' %>">Department</a>
                <a href="/faculty/?sort=title" class="<%= currentSort === 'title' ? 'active' : '' %>">Title</a>
            </div>
        </div>

    <% faculty.forEach(facultyMember => { %>
        <div class="faculty-card">
            <h3 class="faculty-name"><a href="/faculty/<%= facultyMember.slug %>"><%= facultyMember.name %></a></h3>
            <p class="faculty-department"><%= facultyMember.department %></p>
        </div>
    <% }); %>
</div>
</main>
<%- include('../partials/footer') %>
