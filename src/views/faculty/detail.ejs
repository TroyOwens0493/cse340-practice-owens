<%- include('../partials/header') %>
<main>
    <div class="faculty-header">
        <img class="faculty-photo" src="/images/faculty/<%= faculty.slug %>.jpg" alt="Photo of <%= faculty.name %>">
        <div class="faculty-info">
            <h1><%= faculty.name %></h1>
            <p class="faculty-title"><%= faculty.title %></p>
            <p class="faculty-department"><%= faculty.department %></p>
            <p class="faculty-office">Office: <%= faculty.office %></p>
            <p class="faculty-phone">Phone: <%= faculty.phone %></p>
            <p class="faculty-email">Email: <a href="mailto:<%= faculty.email %>"><%= faculty.email %></a></p>
        </div>
    </div>

    <div class="sections">
    </div>

    <div class="navigation">
        <p><a href="/faculty">&larr; Back to Faculty</a></p>
    </div>
</main>
<%- include('../partials/footer') %>
